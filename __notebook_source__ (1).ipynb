





# =========================================================
# MODULE 1 — UNDERSTANDING THE DATASET
# =========================================================

# ---------- 1.1 Imports ----------
import os, re, pickle, warnings
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import (train_test_split, cross_val_score,
                                     StratifiedKFold, GridSearchCV)
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.impute import SimpleImputer
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier
from sklearn.metrics import (accuracy_score, precision_score, recall_score,
                             f1_score, roc_auc_score, confusion_matrix,
                             classification_report, ConfusionMatrixDisplay,
                             RocCurveDisplay)

warnings.filterwarnings("ignore")
sns.set_style("whitegrid")
plt.rcParams["figure.figsize"] = (10, 5)
RANDOM_STATE = 42

# ---------- 1.2 Load data ----------
DATA_PATH = "/kaggle/input/datasets/anwarkhanniazi/supervised-learning-classification/Titanic-Dataset.csv"
df = pd.read_csv(DATA_PATH)
print("Shape:", df.shape)

# ---------- 1.3 Dataset overview ----------
display(df.head())
print("\n--- Info ---")
df.info()
print("\n--- Describe ---")
display(df.describe(include="all").T)

# ---------- 1.4 Missing values ----------
missing = df.isnull().sum().sort_values(ascending=False)
missing_pct = (missing / len(df) * 100).round(2)
miss_df = pd.DataFrame({"Missing": missing, "Percent": missing_pct})
display(miss_df[miss_df["Missing"] > 0])

plt.figure(figsize=(9, 4))
sns.barplot(x=miss_df[miss_df["Missing"] > 0].index,
            y=miss_df[miss_df["Missing"] > 0]["Percent"], palette="rocket")
plt.title("Missing Values (%)")
plt.ylabel("%")
plt.show()

# ---------- 1.5 Target analysis ----------
print(df["Survived"].value_counts())
print("Survival rate:", round(df["Survived"].mean() * 100, 2), "%")

fig, ax = plt.subplots(1, 2, figsize=(12, 4))
sns.countplot(x="Survived", data=df, palette="Set2", ax=ax[0])
ax[0].set_title("Target Distribution (0=Died, 1=Survived)")
df["Survived"].value_counts().plot.pie(autopct="%1.1f%%", ax=ax[1],
                                       colors=["#ff9999", "#66b3ff"],
                                       labels=["Died", "Survived"])
ax[1].set_ylabel("")
ax[1].set_title("Survival Ratio")
plt.tight_layout(); plt.show()

# ---------- 1.6 EDA plots ----------
fig, axes = plt.subplots(2, 3, figsize=(16, 9))

sns.countplot(x="Sex", hue="Survived", data=df, palette="Set1", ax=axes[0, 0])
axes[0, 0].set_title("Survival by Sex")

sns.countplot(x="Pclass", hue="Survived", data=df, palette="Set1", ax=axes[0, 1])
axes[0, 1].set_title("Survival by Pclass")

sns.histplot(data=df, x="Age", hue="Survived", kde=True, bins=30,
             palette="Set1", ax=axes[0, 2])
axes[0, 2].set_title("Age Distribution")

sns.boxplot(x="Survived", y="Fare", data=df, palette="Set2", ax=axes[1, 0])
axes[1, 0].set_title("Fare vs Survived")

sns.countplot(x="Embarked", hue="Survived", data=df, palette="Set1", ax=axes[1, 1])
axes[1, 1].set_title("Survival by Embarked")

sns.countplot(x="SibSp", hue="Survived", data=df, palette="Set1", ax=axes[1, 2])
axes[1, 2].set_title("Survival by SibSp")

plt.tight_layout(); plt.show()

# Correlation heatmap
plt.figure(figsize=(8, 6))
num_cols = df.select_dtypes(include=np.number).columns
sns.heatmap(df[num_cols].corr(), annot=True, fmt=".2f", cmap="coolwarm")
plt.title("Correlation Heatmap")
plt.show()





# =========================================================
# MODULE 2 — PREPROCESSING & FEATURE ENGINEERING
# =========================================================

# ---------- 2.1 Feature engineering function ----------
def engineer_features(data: pd.DataFrame) -> pd.DataFrame:
    """Apply all feature engineering. MUST be identical in training & app."""
    data = data.copy()

    # Title from Name
    data["Title"] = data["Name"].str.extract(r" ([A-Za-z]+)\.", expand=False)
    rare = ["Lady", "Countess", "Capt", "Col", "Don", "Dr", "Major",
            "Rev", "Sir", "Jonkheer", "Dona"]
    data["Title"] = data["Title"].replace(rare, "Rare")
    data["Title"] = data["Title"].replace(["Mlle", "Ms"], "Miss")
    data["Title"] = data["Title"].replace("Mme", "Mrs")

    # Family features
    data["FamilySize"] = data["SibSp"] + data["Parch"] + 1
    data["IsAlone"]    = (data["FamilySize"] == 1).astype(int)

    # Cabin flag
    data["HasCabin"] = data["Cabin"].notna().astype(int)

    # Fare per person
    data["FarePerPerson"] = data["Fare"] / data["FamilySize"]

    # Age imputation using Title-group median
    data["Age"] = data.groupby("Title")["Age"].transform(lambda x: x.fillna(x.median()))
    data["Age"] = data["Age"].fillna(data["Age"].median())

    # Fare / Embarked imputation
    data["Fare"]     = data["Fare"].fillna(data["Fare"].median())
    data["Embarked"] = data["Embarked"].fillna(data["Embarked"].mode()[0])

    return data

# ---------- 2.2 Apply ----------
df_fe = engineer_features(df)
display(df_fe.head())

# ---------- 2.3 Feature selection ----------
TARGET = "Survived"
DROP_COLS = ["PassengerId", "Name", "Ticket", "Cabin", TARGET]

NUM_FEATURES = ["Age", "Fare", "SibSp", "Parch", "FamilySize", "FarePerPerson"]
CAT_FEATURES = ["Pclass", "Sex", "Embarked", "Title", "IsAlone", "HasCabin"]

X = df_fe[NUM_FEATURES + CAT_FEATURES]
y = df_fe[TARGET]

print("X shape:", X.shape)
print("Numeric:", NUM_FEATURES)
print("Categorical:", CAT_FEATURES)

# ---------- 2.4 Preprocessing pipeline ----------
numeric_transformer = Pipeline(steps=[
    ("imputer", SimpleImputer(strategy="median")),
    ("scaler",  StandardScaler())
])

categorical_transformer = Pipeline(steps=[
    ("imputer", SimpleImputer(strategy="most_frequent")),
    ("onehot",  OneHotEncoder(handle_unknown="ignore"))
])

preprocessor = ColumnTransformer(transformers=[
    ("num", numeric_transformer, NUM_FEATURES),
    ("cat", categorical_transformer, CAT_FEATURES)
])

# ---------- 2.5 Visualize engineered features ----------
fig, ax = plt.subplots(1, 3, figsize=(16, 4))
sns.countplot(x="Title", hue="Survived", data=df_fe, palette="Set2", ax=ax[0])
ax[0].set_title("Title vs Survived"); ax[0].tick_params(axis="x", rotation=45)

sns.countplot(x="FamilySize", hue="Survived", data=df_fe, palette="Set2", ax=ax[1])
ax[1].set_title("FamilySize vs Survived")

sns.countplot(x="HasCabin", hue="Survived", data=df_fe, palette="Set2", ax=ax[2])
ax[2].set_title("HasCabin vs Survived")
plt.tight_layout(); plt.show()





# =========================================================
# MODULE 3 — MACHINE LEARNING
# =========================================================

# ---------- 3.1 Train / Validation split ----------
X_train, X_val, y_train, y_val = train_test_split(
    X, y, test_size=0.20, random_state=RANDOM_STATE, stratify=y
)
print("Train:", X_train.shape, "| Validation:", X_val.shape)

# ---------- 3.2 Define 3 baseline models ----------
models = {
    "Logistic Regression": LogisticRegression(max_iter=1000, random_state=RANDOM_STATE),
    "Random Forest":       RandomForestClassifier(n_estimators=300, random_state=RANDOM_STATE),
    "Gradient Boosting":   GradientBoostingClassifier(n_estimators=200,
                                                      learning_rate=0.05,
                                                      random_state=RANDOM_STATE)
}

# ---------- 3.3 Train + Evaluate ----------
results = {}
fitted_pipelines = {}

for name, clf in models.items():
    pipe = Pipeline(steps=[("prep", preprocessor), ("clf", clf)])
    pipe.fit(X_train, y_train)

    y_pred  = pipe.predict(X_val)
    y_proba = pipe.predict_proba(X_val)[:, 1]

    results[name] = {
        "Accuracy":  accuracy_score(y_val, y_pred),
        "Precision": precision_score(y_val, y_pred),
        "Recall":    recall_score(y_val, y_pred),
        "F1":        f1_score(y_val, y_pred),
        "ROC-AUC":   roc_auc_score(y_val, y_proba),
        "CV (5-fold)": cross_val_score(pipe, X_train, y_train,
                                       cv=StratifiedKFold(5, shuffle=True,
                                                          random_state=RANDOM_STATE),
                                       scoring="accuracy").mean()
    }
    fitted_pipelines[name] = pipe

    print("=" * 60)
    print(f"  {name}")
    print("=" * 60)
    print(classification_report(y_val, y_pred, target_names=["Died", "Survived"]))

# ---------- 3.4 Evaluation table ----------
results_df = pd.DataFrame(results).T.sort_values("F1", ascending=False).round(4)
display(results_df)

# ---------- 3.5 Confusion Matrices ----------
fig, axes = plt.subplots(1, 3, figsize=(16, 4.5))
for ax, (name, pipe) in zip(axes, fitted_pipelines.items()):
    ConfusionMatrixDisplay.from_estimator(pipe, X_val, y_val,
                                          display_labels=["Died", "Survived"],
                                          cmap="Blues", ax=ax, colorbar=False)
    ax.set_title(name)
plt.tight_layout(); plt.show()

# ---------- 3.6 ROC Curves ----------
plt.figure(figsize=(7, 6))
for name, pipe in fitted_pipelines.items():
    RocCurveDisplay.from_estimator(pipe, X_val, y_val, name=name, ax=plt.gca())
plt.plot([0, 1], [0, 1], "k--", alpha=0.4)
plt.title("ROC Curves — Model Comparison")
plt.show()

# ---------- 3.7 Bar comparison ----------
results_df[["Accuracy", "F1", "ROC-AUC"]].plot(kind="bar", figsize=(10, 5),
                                               colormap="viridis", edgecolor="black")
plt.title("Model Comparison")
plt.ylabel("Score")
plt.xticks(rotation=15)
plt.ylim(0.6, 1.0)
plt.legend(loc="lower right")
plt.tight_layout(); plt.show()

# ---------- 3.8 Hyperparameter tuning on best model ----------
best_name = results_df["F1"].idxmax()
print(f"🏆 Best baseline model: {best_name}")

param_grids = {
    "Logistic Regression": {"clf__C": [0.01, 0.1, 1, 10], "clf__penalty": ["l2"]},
    "Random Forest":       {"clf__n_estimators": [200, 400],
                            "clf__max_depth": [None, 5, 10],
                            "clf__min_samples_split": [2, 5]},
    "Gradient Boosting":   {"clf__n_estimators": [100, 200, 300],
                            "clf__learning_rate": [0.01, 0.05, 0.1],
                            "clf__max_depth": [3, 5]}
}

best_pipe = Pipeline(steps=[("prep", preprocessor), ("clf", models[best_name])])
grid = GridSearchCV(best_pipe, param_grids[best_name],
                    cv=StratifiedKFold(5, shuffle=True, random_state=RANDOM_STATE),
                    scoring="f1", n_jobs=-1, verbose=1)
grid.fit(X_train, y_train)

print("Best params:", grid.best_params_)
print("Best CV F1 :", round(grid.best_score_, 4))





# =========================================================
# MODULE 4 — FINAL MODEL & SUBMISSION
# =========================================================

# ---------- 4.1 Compare (tuned vs baseline) ----------
final_model = grid.best_estimator_
y_pred_final  = final_model.predict(X_val)
y_proba_final = final_model.predict_proba(X_val)[:, 1]

final_metrics = {
    "Accuracy":  accuracy_score(y_val, y_pred_final),
    "Precision": precision_score(y_val, y_pred_final),
    "Recall":    recall_score(y_val, y_pred_final),
    "F1":        f1_score(y_val, y_pred_final),
    "ROC-AUC":   roc_auc_score(y_val, y_proba_final),
}
print("Final Tuned Model Metrics:")
for k, v in final_metrics.items():
    print(f"  {k:<10}: {v:.4f}")

# ---------- 4.2 Train on FULL data ----------
final_model.fit(X, y)
print("\n✅ Final model retrained on 100% of data.")

# ---------- 4.3 Feature importance (if tree model) ----------
clf = final_model.named_steps["clf"]
if hasattr(clf, "feature_importances_"):
    feat_names = final_model.named_steps["prep"].get_feature_names_out()
    imp = pd.Series(clf.feature_importances_, index=feat_names).sort_values(ascending=False).head(15)
    plt.figure(figsize=(9, 6))
    sns.barplot(x=imp.values, y=imp.index, palette="viridis")
    plt.title("Top 15 Feature Importances")
    plt.tight_layout(); plt.show()

# ---------- 4.4 Save model as .pkl ----------
MODEL_PATH = "titanic_best_model.pkl"
with open(MODEL_PATH, "wb") as f:
    pickle.dump(final_model, f)
print(f"💾 Model saved → {MODEL_PATH}  ({os.path.getsize(MODEL_PATH)/1024:.1f} KB)")

# ---------- 4.5 Predict on validation & build submission ----------
submission = pd.DataFrame({
    "PassengerId": df.loc[X_val.index, "PassengerId"],
    "Survived":    y_pred_final
}).sort_values("PassengerId").reset_index(drop=True)

submission.to_csv("submission.csv", index=False)
print("\n📄 submission.csv saved!")
display(submission.head(10))
print("Survival distribution:")
print(submission["Survived"].value_counts())



